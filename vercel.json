{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node --test tests/*.test.mjs && node scripts/build-public-site.mjs",
  "outputDirectory": "_site",
  "functions": {
    "api/embroidery.py": {
      "maxDuration": 30,
      "includeFiles": "embroidery/**",
      "excludeFiles": "{embroidery/tests/**,embroidery/samples/**,embroidery/reports/**,embroidery/licenses/**,embroidery/**/__pycache__/**}"
    }
  }
}
