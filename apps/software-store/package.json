{
  "name": "@woramet/software-store",
  "version": "0.2.0-rc.3",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.test tests/integration.mjs",
    "test:e2e": "playwright test",
    "package:school": "node scripts/package-school.mjs",
    "test:storage": "node --env-file-if-exists=.env.test tests/storage.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "0.577.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "archiver": "8.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.33",
    "readdir-glob": {
      "minimatch": "11.0.9"
    }
  }
}
