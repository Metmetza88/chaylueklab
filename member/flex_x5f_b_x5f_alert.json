{
  "type": "flex",
  "altText": "⏰ ถึงเวลาแล้ว {{task}}",
  "contents": {
    "type": "bubble",
    "size": "mega",
    "header": {
      "type": "box",
      "layout": "vertical",
      "backgroundColor": "#0A1210",
      "contents": [
        {
          "type": "text",
          "text": "⏰ ถึงเวลาแล้ว",
          "color": "#D4AF37",
          "weight": "bold"
        },
        {
          "type": "text",
          "text": "{{task}}",
          "color": "#FFFFFF",
          "weight": "bold",
          "size": "xxl",
          "wrap": true,
          "margin": "md"
        }
      ],
      "paddingAll": "20px"
    },
    "body": {
      "type": "box",
      "layout": "vertical",
      "backgroundColor": "#0A1210",
      "contents": [
        {
          "type": "box",
          "layout": "horizontal",
          "contents": [
            {
              "type": "text",
              "text": "วันที่ {{date}}",
              "color": "#7A9E8E",
              "size": "xs"
            },
            {
              "type": "text",
              "text": "{{time}} น.",
              "color": "#D4AF37",
              "weight": "bold",
              "size": "xl",
              "align": "end"
            }
          ]
        },
        {
          "type": "text",
          "text": "ผู้ช่วยชายลึกลับ • เตือนอัตโนมัติ",
          "color": "#4A5A54",
          "size": "xxs",
          "margin": "md"
        }
      ],
      "paddingAll": "20px"
    },
    "footer": {
      "type": "box",
      "layout": "vertical",
      "backgroundColor": "#0A1210",
      "spacing": "sm",
      "contents": [
        {
          "type": "box",
          "layout": "horizontal",
          "spacing": "sm",
          "contents": [
            {
              "type": "button",
              "style": "primary",
              "color": "#06C755",
              "action": {
                "type": "message",
                "label": "✅ เสร็จแล้ว",
                "text": "เสร็จแล้ว {{id}}"
              }
            },
            {
              "type": "button",
              "style": "secondary",
              "action": {
                "type": "message",
                "label": "⏰ +10 นาที",
                "text": "เลื่อน 10 นาที {{id}}"
              }
            }
          ]
        },
        {
          "type": "button",
          "style": "link",
          "action": {
            "type": "uri",
            "label": "เปิด CHAYLUEKLAB",
            "uri": "https://metmetza88.github.io/chaylueklab/"
          }
        }
      ]
    }
  }
}